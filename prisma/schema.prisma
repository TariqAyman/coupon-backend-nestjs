  users_upload_media_updatedByIdTousers users?    @relation("upload_media_updatedByIdTousers", fields: [updatedById], references: [id], onUpdate: NoAction, map: "FK_8dc3abb31f7faa70a199755a169")
  users_upload_media_createdByIdTousers users?    @relation("upload_media_createdByIdTousers", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_bb5c7cebd4e80a684f17daf33ce")

  @@index([updatedById], map: "FK_8dc3abb31f7faa70a199755a169")
  @@index([createdById], map: "FK_bb5c7cebd4e80a684f17daf33ce")
}

model user_disliked_coupons {
  user_id   String   @db.Char(36)
  coupon_id String   @db.Char(36)
  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @default(now()) @db.Timestamp(0)
  coupons   coupons  @relation(fields: [coupon_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_disliked_coupons_coupon_id_foreign_key")
