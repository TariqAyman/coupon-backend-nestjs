generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ads {
  id                           String          @id @db.Char(36)
  name                         String          @db.VarChar(255)
  link                         String          @db.VarChar(255)
  image                        String?         @db.VarChar(255)
  seoDescription               Json?
  seoKeywords                  Json?
  ogTitle                      Json?
  ogDescription                Json?
  ogImage                      String?         @db.Text
  ogUrl                        String?         @db.Text
  twitterCard                  String?         @db.Text
  twitterTitle                 Json?
  twitterDescription           Json?
  twitterImage                 String?         @db.Text
  createdById                  String?         @db.Char(36)
  updatedById                  String?         @db.Char(36)
  createdAt                    DateTime        @default(now()) @db.Timestamp(0)
  updatedAt                    DateTime        @default(now()) @db.Timestamp(0)
  deletedAt                    DateTime?       @db.Timestamp(0)
  users_ads_createdByIdTousers users?          @relation("ads_createdByIdTousers", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_0c97a55ed44c338ea0e11dde597")
  users_ads_updatedByIdTousers users?          @relation("ads_updatedByIdTousers", fields: [updatedById], references: [id], onUpdate: NoAction, map: "FK_1e32cccaa72c21d19febd24047e")
  ads_countries                ads_countries[]

  @@index([createdById], map: "FK_0c97a55ed44c338ea0e11dde597")
  @@index([updatedById], map: "FK_1e32cccaa72c21d19febd24047e")
}

model ads_countries {
  ads_id     String    @db.Char(36)
  country_id String    @db.Char(36)
  createdAt  DateTime  @default(now()) @db.Timestamp(0)
  updatedAt  DateTime  @default(now()) @db.Timestamp(0)
  ads        ads       @relation(fields: [ads_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ads_countries_ads_id_foreign_key")
  countries  countries @relation(fields: [country_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ads_countries_country_id_foreign_key")

  @@id([ads_id, country_id])
  @@index([country_id], map: "ads_countries_country_id_foreign_key")
}

model brand_categories {
  brand_id    String     @db.Char(36)
  category_id String     @db.Char(36)
  createdAt   DateTime   @default(now()) @db.Timestamp(0)
  updatedAt   DateTime   @default(now()) @db.Timestamp(0)
  brands      brands     @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "brand_categories_brand_id_foreign_key")
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "brand_categories_category_id_foreign_key")

  @@id([brand_id, category_id])
  @@index([category_id], map: "brand_categories_category_id_foreign_key")
}

model brand_countries {
  brand_id   String    @db.Char(36)
  country_id String    @db.Char(36)
  createdAt  DateTime  @default(now()) @db.Timestamp(0)
  updatedAt  DateTime  @default(now()) @db.Timestamp(0)
  brands     brands    @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "brand_countries_brand_id_foreign_key")
  countries  countries @relation(fields: [country_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "brand_countries_country_id_foreign_key")

  @@id([brand_id, country_id])
  @@index([country_id], map: "brand_countries_country_id_foreign_key")
}

model brands {
  id                              String                 @id @db.Char(36)
  name                            Json
  slug                            String                 @db.VarChar(255)
  description                     Json?
  link                            String                 @db.VarChar(255)
  image                           String?                @db.VarChar(255)
  seoDescription                  Json?
  seoKeywords                     Json?
  ogTitle                         Json?
  ogDescription                   Json?
  ogImage                         String?                @db.Text
  ogUrl                           String?                @db.Text
  twitterCard                     String?                @db.Text
  twitterTitle                    Json?
  twitterDescription              Json?
  twitterImage                    String?                @db.Text
  mostUsed                        Int                    @default(0)
  mostFollowed                    Int                    @default(0)
  createdById                     String?                @db.Char(36)
  updatedById                     String?                @db.Char(36)
  createdAt                       DateTime               @default(now()) @db.Timestamp(0)
  updatedAt                       DateTime               @default(now()) @db.Timestamp(0)
  deletedAt                       DateTime?              @db.Timestamp(0)
  brand_categories                brand_categories[]
  brand_countries                 brand_countries[]
  users_brands_updatedByIdTousers users?                 @relation("brands_updatedByIdTousers", fields: [updatedById], references: [id], onUpdate: NoAction, map: "FK_362fe42f4b94ec5c00b7e9f5b79")
  users_brands_createdByIdTousers users?                 @relation("brands_createdByIdTousers", fields: [createdById], references: [id], onUpdate: NoAction, map: "FK_906c44274a237e695ffc8d8f8f3")
  coupon_brands                   coupon_brands[]
  user_followed_brands            user_followed_brands[]

  @@index([updatedById], map: "FK_362fe42f4b94ec5c00b7e9f5b79")
  @@index([createdById], map: "FK_906c44274a237e695ffc8d8f8f3")
}

model categories {
  id                                  String               @id @db.Char(36)
  name                                Json
  slug                                Json
  description                         Json?
  image                               String?              @db.VarChar(255)
  icon                                String?              @db.VarChar(255)
  color                               String?              @db.VarChar(255)
  seoDescription                      Json?
  seoKeywords                         Json?
  ogTitle                             Json?
  ogDescription                       Json?
  ogImage                             String?              @db.Text
  ogUrl                               String?              @db.Text
  twitterCard                         String?              @db.Text
  twitterTitle                        Json?
  twitterDescription                  Json?
  twitterImage                        String?              @db.Text
  createdById                         String?              @db.Char(36)
  updatedById                         String?              @db.Char(36)
  createdAt                           DateTime             @default(now()) @db.Timestamp(0)
  updatedAt                           DateTime             @default(now()) @db.Timestamp(0)
  deletedAt                           DateTime?            @db.Timestamp(0)
  brand_categories                    brand_categories[]
  users_categories_createdByIdTousers users?               @relation("categories_createdByIdTousers", fields: [createdById], references: [id], onUpdate: NoAction, map: "FK_a6ada6f4dcf60db496fe71d7a96")
  users_categories_updatedByIdTousers users?               @relation("categories_updatedByIdTousers", fields: [updatedById], references: [id], onUpdate: NoAction, map: "FK_e8221f562fcc5898e530aa1be6e")
  category_countries                  category_countries[]
  coupon_categories                   coupon_categories[]

  @@index([createdById], map: "FK_a6ada6f4dcf60db496fe71d7a96")
  @@index([updatedById], map: "FK_e8221f562fcc5898e530aa1be6e")
}

model category_countries {
  category_id String     @db.Char(36)
  country_id  String     @db.Char(36)
  createdAt   DateTime   @default(now()) @db.Timestamp(0)
  updatedAt   DateTime   @default(now()) @db.Timestamp(0)
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "category_countries_category_id_foreign_key")
