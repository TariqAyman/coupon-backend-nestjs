  id        String    @id @db.Char(36)
  userId    String    @db.Char(36)
  token     String    @db.Text
  os        String    @db.VarChar(255)
  osVersion String    @db.VarChar(255)
  model     String    @db.VarChar(255)
  country   String    @db.VarChar(255)
  location  String?   @db.VarChar(255)
  topics    Json?
  createdAt DateTime? @db.Timestamp(0)
  updatedAt DateTime? @db.Timestamp(0)
  deletedAt DateTime? @db.Timestamp(0)
  users     users     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_92ce9a299624e4c4ffd99b645b6")

  @@index([userId], map: "FK_92ce9a299624e4c4ffd99b645b6")
