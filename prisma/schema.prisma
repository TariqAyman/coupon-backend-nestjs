  users_notifications_createdByIdTousers users?    @relation("notifications_createdByIdTousers", fields: [createdById], references: [id], onUpdate: NoAction, map: "FK_fcce8c50a375466676d82dcbadd")

  @@index([userId], map: "FK_692a909ee0fa9383e7859f9b406")
  @@index([createdById], map: "FK_fcce8c50a375466676d82dcbadd")
}

