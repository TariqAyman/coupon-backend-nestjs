model coupon_countries {
  coupon_id  String    @db.Char(36)
  country_id String    @db.Char(36)
  createdAt  DateTime  @default(now()) @db.Timestamp(0)
  updatedAt  DateTime  @default(now()) @db.Timestamp(0)
  countries  countries @relation(fields: [country_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "coupon_countries_country_id_foreign_key")
  coupons    coupons   @relation(fields: [coupon_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "coupon_countries_coupon_id_foreign_key")

  @@id([coupon_id, country_id])
  @@index([country_id], map: "coupon_countries_country_id_foreign_key")
}

model coupons {
  id                               String                  @id @db.Char(36)
  code                             String                  @db.VarChar(255)
  amount                           Float                   @default(1) @db.Float
  description                      Json?
  status                           Json
  expire                           DateTime?               @db.Timestamp(0)
  qrCode                           String?                 @db.VarChar(255)
  link                             String?                 @db.VarChar(255)
  seoDescription                   Json?
  seoKeywords                      Json?
  ogTitle                          Json?
  ogDescription                    Json?
  ogImage                          String?                 @db.Text
  ogUrl                            String?                 @db.Text
  twitterCard                      String?                 @db.Text
  twitterTitle                     Json?
  twitterDescription               Json?
  twitterImage                     String?                 @db.Text
  usedCount                        Int                     @default(0)
  likeCount                        Int                     @default(0)
  dislikeCount                     Int                     @default(0)
  createdById                      String?                 @db.Char(36)
  updatedById                      String?                 @db.Char(36)
  createdAt                        DateTime                @default(now()) @db.Timestamp(0)
  updatedAt                        DateTime                @default(now()) @db.Timestamp(0)
  deletedAt                        DateTime?               @db.Timestamp(0)
  coupon_brands                    coupon_brands[]
  coupon_categories                coupon_categories[]
  coupon_countries                 coupon_countries[]
  users_coupons_createdByIdTousers users?                  @relation("coupons_createdByIdTousers", fields: [createdById], references: [id], onUpdate: NoAction, map: "FK_0469ba4cb398e58d873e9d8c25a")
  users_coupons_updatedByIdTousers users?                  @relation("coupons_updatedByIdTousers", fields: [updatedById], references: [id], onUpdate: NoAction, map: "FK_5fb1c171c25220ad4248aaa36d0")
  user_disliked_coupons            user_disliked_coupons[]
  user_favorite_coupons            user_favorite_coupons[]
  user_followed_coupons            user_followed_coupons[]
  user_liked_coupons               user_liked_coupons[]

  @@index([createdById], map: "FK_0469ba4cb398e58d873e9d8c25a")
  @@index([updatedById], map: "FK_5fb1c171c25220ad4248aaa36d0")
}

model migrations {
  id        Int    @id @default(autoincrement())
  timestamp BigInt
  name      String @db.VarChar(255)
}

model notifications {
