  coupon_id   String     @db.Char(36)
  category_id String     @db.Char(36)
  createdAt   DateTime   @default(now()) @db.Timestamp(0)
  updatedAt   DateTime   @default(now()) @db.Timestamp(0)
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "coupon_categories_category_id_foreign_key")
  coupons     coupons    @relation(fields: [coupon_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "coupon_categories_coupon_id_foreign_key")

  @@id([coupon_id, category_id])
