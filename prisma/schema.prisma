model users {
  id                                             String                  @id @db.Char(36)
  fullName                                       String                  @db.VarChar(255)
  email                                          String                  @db.VarChar(255)
  password                                       String                  @db.VarChar(255)
  changePasswordTime                             DateTime?               @db.Timestamp(0)
  phoneNumber                                    String?                 @db.VarChar(255)
  phoneNumberCountryCode                         String?                 @db.VarChar(255)
  countryCode                                    String?                 @db.VarChar(255)
  userLocale                                     String                  @db.VarChar(255)
  role                                           users_role              @default(User)
  confirmAccount                                 Boolean                 @default(true)
  status                                         users_status            @default(offline)
  avatar                                         String?                 @db.VarChar(255)
  birthday                                       DateTime?               @db.Timestamp(0)
  joined                                         DateTime?               @db.Timestamp(0)
  gender                                         users_gender?
  provider                                       users_provider          @default(system)
  verificationCode                               String?                 @db.VarChar(255)
  verificationCodeExpiresAt                      DateTime?               @db.Timestamp(0)
  createdAt                                      DateTime                @default(now()) @db.Timestamp(0)
  updatedAt                                      DateTime                @default(now()) @db.Timestamp(0)
  deletedAt                                      DateTime?               @db.Timestamp(0)
  lastLogin                                      DateTime?               @db.Timestamp(0)
  lastLogout                                     DateTime?               @db.Timestamp(0)
  ads_ads_createdByIdTousers                     ads[]                   @relation("ads_createdByIdTousers")
  ads_ads_updatedByIdTousers                     ads[]                   @relation("ads_updatedByIdTousers")
  brands_brands_updatedByIdTousers               brands[]                @relation("brands_updatedByIdTousers")
  brands_brands_createdByIdTousers               brands[]                @relation("brands_createdByIdTousers")
  categories_categories_createdByIdTousers       categories[]            @relation("categories_createdByIdTousers")
  categories_categories_updatedByIdTousers       categories[]            @relation("categories_updatedByIdTousers")
  countries_countries_updatedByIdTousers         countries[]             @relation("countries_updatedByIdTousers")
  countries_countries_createdByIdTousers         countries[]             @relation("countries_createdByIdTousers")
  coupons_coupons_createdByIdTousers             coupons[]               @relation("coupons_createdByIdTousers")
  coupons_coupons_updatedByIdTousers             coupons[]               @relation("coupons_updatedByIdTousers")
  notifications_notifications_userIdTousers      notifications[]         @relation("notifications_userIdTousers")
  notifications_notifications_createdByIdTousers notifications[]         @relation("notifications_createdByIdTousers")
  upload_media_upload_media_updatedByIdTousers   upload_media[]          @relation("upload_media_updatedByIdTousers")
  upload_media_upload_media_createdByIdTousers   upload_media[]          @relation("upload_media_createdByIdTousers")
  user_disliked_coupons                          user_disliked_coupons[]
  user_favorite_coupons                          user_favorite_coupons[]
  user_followed_brands                           user_followed_brands[]
  user_followed_coupons                          user_followed_coupons[]
  user_liked_coupons                             user_liked_coupons[]
  user_tokens                                    user_tokens[]
}

enum users_role {
  User
  Admin
  Employee
}

enum users_status {
  offline
  online
  blocked
}

enum users_gender {
  male
  female
}

enum users_provider {
  system
  facebook
  GOOGLE
}
