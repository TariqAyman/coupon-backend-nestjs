  users_countries_updatedByIdTousers users?               @relation("countries_updatedByIdTousers", fields: [updatedById], references: [id], onUpdate: NoAction, map: "FK_3e2244849b34c8a2536c35d335d")
  users_countries_createdByIdTousers users?               @relation("countries_createdByIdTousers", fields: [createdById], references: [id], onUpdate: NoAction, map: "FK_c641ee0320064ee9dced39b5bea")
  coupon_countries                   coupon_countries[]

  @@index([updatedById], map: "FK_3e2244849b34c8a2536c35d335d")
  @@index([createdById], map: "FK_c641ee0320064ee9dced39b5bea")
}

model coupon_brands {
  coupon_id String   @db.Char(36)
  brand_id  String   @db.Char(36)
  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @default(now()) @db.Timestamp(0)
  brands    brands   @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "coupon_brands_brand_id_foreign_key")
  coupons   coupons  @relation(fields: [coupon_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "coupon_brands_coupon_id_foreign_key")

  @@id([coupon_id, brand_id])
  @@index([brand_id], map: "coupon_brands_brand_id_foreign_key")
}

